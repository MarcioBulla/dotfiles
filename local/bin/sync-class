#!/bin/sh

sync_config=${XDG_CONFIG_HOME:-"$HOME/.config"}/sync-class.env
if [ -r "$sync_config" ]; then
  # Private machine-specific values stay outside the public dotfiles repository.
  . "$sync_config"
fi

if [ -z "${SYNC_CLASS_DRIVE_ROOT_FOLDER_ID:-}" ]; then
  echo "Defina SYNC_CLASS_DRIVE_ROOT_FOLDER_ID em $sync_config." >&2
  exit 78
fi

lock_dir=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
if [ ! -d "$lock_dir" ] || [ ! -w "$lock_dir" ]; then
  lock_dir=${TMPDIR:-/tmp}
fi
exec 9>"$lock_dir/sync-class.lock"

if ! flock -n 9; then
  echo "A sincronização da pasta Class já está em execução." >&2
  exit 75
fi

if [ -t 1 ]; then
  set -- --progress --stats 1s --stats-one-line "$@"
else
  set -- --stats 1m --stats-one-line-date "$@"
fi

exec rclone bisync \
  "$HOME/Documents/Class" \
  doctorado: \
  --drive-root-folder-id "$SYNC_CLASS_DRIVE_ROOT_FOLDER_ID" \
  --create-empty-src-dirs \
  --fast-list \
  --exclude '/.*' \
  --exclude '**/.*' \
  --exclude '/.*/**' \
  --exclude '**/.*/**' \
  --exclude '/_*' \
  --exclude '**/_*' \
  --exclude '/_*/**' \
  --exclude '**/_*/**' \
  --exclude 'AGENTS.md' \
  --exclude '**/AGENTS.md' \
  --exclude 'graphify-out/**' \
  --exclude '**/graphify-out/**' \
  --exclude '*.swp' \
  --exclude '*.swo' \
  --exclude '*~' \
  --exclude '*.pyc' \
  --compare size,modtime \
  --resilient \
  --recover \
  --max-lock 2m \
  --conflict-resolve newer \
  --conflict-loser num \
  "$@"
